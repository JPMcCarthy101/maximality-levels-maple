    <Input>
      <Text-field alignment="left" style="Maple Input" layout="Normal" xml:space="preserve"># Moment level five, self-contained symbolic computation.
# The paper's five singleton deletions, four adjacent merges, and wrap merge.
# These reconstructed routines match the original 10 x 10 mathematical setup.
# This source has NOT been run in Maple in the present environment.
restart:
printf("Moment five; Maple version: %a\n",kernelopts(version)):

