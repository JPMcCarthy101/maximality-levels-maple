    <Input>
      <Text-field alignment="left" style="Maple Input" layout="Normal" xml:space="preserve"># 8. Compare another polynomial basis AFTER executing this file.
# Wpaper must have the SAME partition-row order and five columns.
# Do NOT assume Maple NullSpace chooses the same normalized basis.
# This procedure derives Wpaper=V S, checks ALL 71 rows and full column rank.
# Use: S := CompareBasis(Wpaper);
# Its coordinates satisfy t_explainer = S . t_paper.
CompareBasis := proc(Wpaper)
    local S,deltaS;
    if LinearAlgebra:-RowDimension(Wpaper)&lt;&gt;71 or
       LinearAlgebra:-ColumnDimension(Wpaper)&lt;&gt;5 then
        error "Expected a 71 x 5 matrix in CR6 row order";
    end if;
    S := map(normal,LinearAlgebra:-MatrixInverse(D0) . Wpaper[67..71,1..5]);
    CheckMatrix(Wpaper-V . S,"Wpaper = V S, all rows checked");
    deltaS := factor(LinearAlgebra:-Determinant(S));
    if deltaS=0 then error "Wpaper is not generically a basis" end if;
    printf("Basis-change determinant; check exceptional parameter values:\n");
    print(deltaS);
    S
end proc:

printf("Quadratic-form computation finished.\n"):
