  <Group view="presentation" hide-input="false" hide-output="false" inline-output="false" drawlabel="true">
    <Input>
      <Text-field alignment="left" style="Maple Input" layout="Normal" xml:space="preserve"># 7. Direct comparison with the manuscript's final two-case algebra.
# These checks start from g_N, h_N, k_N derived above by partition gluing;
# the expected identities are then tested as exact polynomials.
CheckZero(hN+kN-(N-1)*gN-(N-2)*
          (a-2*(N-2)*b+(N-4)*c)*(a+2*(N-2)*b-(N-2)*c),
          "equation (28), product of two linear factors"):

# Case 1 in equation (29): a=2(N-2)b-(N-4)c.
aCase1 := 2*(N-2)*b-(N-4)*c:
g1 := expand(subs(a=aCase1,gN)):
k1 := expand(subs(a=aCase1,kN)):
g1Expected := (14-3*N)*(N-2)^2*b^2+2*(N^2-10*N+26)*(N-2)*b*c
              +(2*N^2-20*N+49)*c^2:
g1MinusK1Expected := (N-5)*((2*N-9)*c^2-(N-4)*(N-2)^2*b^2):
CheckZero(g1-g1Expected,"equation (29), first expression"):
CheckZero(g1-k1-g1MinusK1Expected,"equation (29), second expression"):

# Eliminate b^2 using g1-k1=0, obtaining the paper's linear relation in b,c.
Dpoly := N^2-10*N+26:
Bpoly := (N-4)*(N-5)*(N-8)-1:
# Here (N-5)&lt;&gt;0 in the region N&gt;=6.
CheckZero((N-5)*(N-4)*g1-(3*N-14)*(g1-k1)
          -(N-5)*2*c*((N-4)*(N-2)*Dpoly*b+Bpoly*c),
          "Case 1 elimination following equation (30)"):
# Equation (31) follows algebraically under the two assumed equations
# and c&lt;&gt;0; its divisibility contradiction is proved in the manuscript.

# Case 2 in equation (32): v=(N-2)b-c and a=-2(N-2)b+(N-2)c.
# Thus b=(v+c)/(N-2) and a=-2v+(N-4)c.
Epoly := N^2-4*N+2:
g2 := expand(normal(subs({a=-2*v+(N-4)*c,b=(v+c)/(N-2)},gN))):
k2 := expand(normal(subs({a=-2*v+(N-4)*c,b=(v+c)/(N-2)},kN))):
g2Expected := (5*N-2)*v^2-2*N*(N-5)*v*c-3*(N-5)*c^2:
k2Expected := Epoly*v^2-(N-5)*(N-2)*c^2:
CheckZero(g2-g2Expected,"equation (32), g"):
CheckZero(k2-k2Expected,"equation (32), k"):
CheckZero(Epoly*g2-(5*N-2)*k2
          -2*(N-5)*c*((N^2-1)*c-N*Epoly*v),
          "equation (33), eliminate v^2"):
# Equation (34) is the consequent equality under g2=k2=0,c&lt;&gt;0.
# Its modular contradiction is a mathematical argument in the paper.
printf("PASS: manuscript equations (28)-(33) verified symbolically.\n"):
printf("Moment-six source reached the final statement without a Maple error.\n"):
