    <Input>
      <Text-field alignment="left" style="Maple Input" layout="Normal" xml:space="preserve"># 3. Compute every crossing coefficient. Sum over ORDERED pairs of partitions.
# There are no complex conjugates in this operation: it squares A_xi.
beta := Vector(71):
for ii to 71 do for jj to 71 do
    squareImage := SquareGlue(CR6[ii],CR6[jj]);
    if not Crossing(squareImage[1]) then next end if;
    outrow := 0;
    for rr to 71 do
        if CR6[rr]=squareImage[1] then outrow:=rr; break; end if;
    end do;
    if outrow=0 then error "Crossing output not found" end if;
    beta[outrow] := beta[outrow]+N^squareImage[2]*alpha[ii]*alpha[jj];
end do; end do:
beta := map(expand,beta):
