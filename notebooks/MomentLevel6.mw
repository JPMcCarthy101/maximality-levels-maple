    <Input>
      <Text-field alignment="left" style="Maple Input" layout="Normal" xml:space="preserve"># 1. Parameterize the INPUT fixed space, using the shared normalized basis.
if not type(CR6,list) then error "Run the kernel setup groups at the top of this worksheet first" end if:
if nops(CR6)&lt;&gt;71 then error "Expected 71 crossing partitions from the setup" end if:
