  <Group view="presentation" hide-input="false" hide-output="false" inline-output="false" drawlabel="true">
    <Input>
      <Text-field alignment="left" style="Maple Input" layout="Normal" xml:space="preserve"># 3b. The manuscript's chosen 66-column determinant, exact over Q[N].
# A quick run can set RUN_UNIFORM_RANK_CHECK=false at the top; a full run must
# execute the determinant below and compare to the paper's exact expression.
ExpectedDet66 := (N-4)^12*(N-2)*(N^2-3*N+1)^23:
if RUN_UNIFORM_RANK_CHECK then
    printf("Computing and comparing the 66 x 66 determinant (can be expensive)...\n");
    det66 := LinearAlgebra:-Determinant(M66[1..66,1..66],method=fracfree):
    detSign66 := normal(det66/ExpectedDet66):
    if not evalb(detSign66=1 or detSign66=-1) then
        error "The chosen determinant does not match equation (16) up to sign";
    end if;
    printf("PASS equation (16): determinant ratio = %a\n",detSign66);
else
    printf("SKIPPED: exact 66-column determinant. This is a QUICK run only.\n");
end if:
# The explicit factorisation has no zeros at any integer N&gt;=6.
# That conclusion is made in the paper, not inferred from a finite N sweep.
# A separate finite-rank observation in the manuscript concerns N=4.
if RUN_N4_CHECK then
    mAt4 := map(x -&gt; subs(N=4,x),M66):
    if LinearAlgebra:-Rank(mAt4) &lt;&gt; 54 then error "Rank at N=4 is not 54" end if;
    printf("PASS: rank M(4)=54\n");
end if:

</Text-field>
    </Input>
  </Group>
