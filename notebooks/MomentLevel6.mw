for ii to 71 do
    rw := Canon([CR6[ii][6],op(CR6[ii][1..5])]);
    rr := 0;
    for jj to 71 do if CR6[jj]=rw then rr:=jj; break; end if; end do;
    if rr=0 then error "Rotated word not found" end if;
    for jj to 5 do RotV[rr,jj] := V[ii,jj] end do;
end do:
CheckMatrix(RotV-V . R,"actual rotation agrees with coordinate R"):
Pavg := (Id5+R+R . R)/3:
C := Id5-Pavg:
CheckMatrix(Pavg . Pavg-Pavg,"P is idempotent on the kernel"):

