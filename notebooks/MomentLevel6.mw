  <Group view="presentation" hide-input="false" hide-output="false" inline-output="false" drawlabel="true">
    <Input>
      <Text-field alignment="left" style="Maple Input" layout="Normal" xml:space="preserve"># 5. Construct the contraction matrix from the actual partition p.
# Upper pairs: (3,10),(4,9),(5,8),(6,7); pass positions 1,2,11,12.
# It acts on xi tensor conjugate-reversal(xi).
# F(xi)[a,b,c,d] = sum xi[a,b,i,j,k,l] conjugate(xi[d,c,i,j,k,l]).
# On a pair of six-point partition words, the glued equality labels are
# p -&gt; [1,2,3,4,5,6], q -&gt; [8,7,3,4,5,6]; outputs [1,2,7,8].
# Count the connected components that miss the outputs; each contributes N.
ContractCrossing := proc(w::list,v::list)
    local parent,slots,words,which,aa,bb,out,roots,jj;
    parent := Array(1..8,[seq(jj,jj=1..8)]);
    slots := [[1,2,3,4,5,6],[8,7,3,4,5,6]];
    words := [w,v];
    for which to 2 do for aa to 6 do for bb to aa-1 do
        if words[which][aa]=words[which][bb] then
            Join(parent,slots[which][aa],slots[which][bb]);
        end if;
    end do; end do; end do;
    out := [seq(Root(parent,jj),jj in [1,2,7,8])];
    if Canon(out)&lt;&gt;[0,1,0,1] then return 0 end if;
    roots := {seq(Root(parent,jj),jj=1..8)};
    N^nops(roots minus {op(out)})
end proc:
G := Matrix(71,71):
for ii to 71 do for jj to 71 do
    G[ii,jj] := ContractCrossing(CR6[ii],CR6[jj]);
end do; end do:
B := map(factor,LinearAlgebra:-Transpose(V) . G . V):
CheckMatrix(B-LinearAlgebra:-Transpose(B),"B is real symmetric"):
printf("Computed B = transpose(V) G V:\n"):
print(B);

</Text-field>
    </Input>
  </Group>
  <Group view="presentation" hide-input="false" hide-output="false" inline-output="false" drawlabel="true">
    <Input>
      <Text-field alignment="left" style="Heading1" layout="Normal" xml:space="preserve">6. Derive, rather than insert, the two coefficients.</Text-field>
