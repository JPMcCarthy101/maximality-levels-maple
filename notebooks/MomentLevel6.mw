    <Input>
      <Text-field alignment="left" style="Maple Input" layout="Normal" xml:space="preserve"># 5. The assumption theta in ker M forces M66 . beta = 0.
# We only need two particular NECESSARY rows, not a characterization of
# every substituted row. Row 48 caps positions 3,4. Row 59 merges the
# disjoint cyclic pairs {3,4} and {6,1}, in the shared map ordering.
kernelOutput := map(expand,M66 . beta):
kernelCap := factor(kernelOutput[48]):
kernelDoubleMerge := factor(kernelOutput[59]):
printf("Two actual necessary kernel equations (each must vanish):\n"):
print(kernelCap,kernelDoubleMerge);

# For agreement with the earlier explanatory note, take invertible linear
# combinations of these two equations. The denominator is nonzero on N&gt;=6.
# deltaGH(6+s)=38+37s+11s^2+s^3 &gt;0 for s&gt;=0.
deltaGH := N^3-7*N^2+13*N-4:
