CheckZero(denom(normal(hN))-1,"h_N is polynomial, with no remaining denominator"):
CheckZero(kernelCap-N*gN+(N-2)*hN,"first direct row = N*g_N-(N-2)*h_N"):
CheckZero(kernelDoubleMerge-(N^2-4*N+2)*gN-(3-N)*hN,
          "second direct row = (N^2-4N+2)*g_N+(3-N)*h_N"):



