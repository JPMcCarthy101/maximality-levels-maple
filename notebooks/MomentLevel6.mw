  <Group view="presentation" hide-input="false" hide-output="false" inline-output="false" drawlabel="true">
    <Input>
      <Text-field alignment="left" style="Maple Input" layout="Normal" xml:space="preserve"># 6. Derive, rather than insert, the two coefficients.
# t is arbitrary, xi has coefficient vector V C t, z1=t1-t4, z2=t2-t5.
# Qc represents q(Ct). Its first two rows/columns determine H if
