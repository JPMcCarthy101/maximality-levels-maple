    <Input>
      <Text-field alignment="left" style="Maple Input" layout="Normal" xml:space="preserve"># 4. Display the actual quadratic polynomials, including any zero rows.
# This is also a 71 x 6 table in monomial order a^2,ab,ac,b^2,bc,c^2.
CoeffABC := proc(f,powers::list)
    coeff(coeff(coeff(expand(f),a,powers[1]),b,powers[2]),c,powers[3])
end proc:
Powers2 := [[2,0,0],[1,1,0],[1,0,1],[0,2,0],[0,1,1],[0,0,2]]:
Mon2 := [a^2,a*b,a*c,b^2,b*c,c^2]:
QuadTable := Matrix(71,6):
if SHOW_ALL_SQUARING_ROWS then printf("Rows below are [partition word, beta_p(a,b,c)].\n") end if:
for ii to 71 do
    CheckZero(subs({a=tScale*a,b=tScale*b,c=tScale*c},beta[ii])-tScale^2*beta[ii],
              cat("homogeneity of beta row ",ii));
    for jj to 6 do QuadTable[ii,jj] := factor(CoeffABC(beta[ii],Powers2[jj])) end do;
    CheckZero(beta[ii]-add(QuadTable[ii,jj]*Mon2[jj],jj=1..6),
              cat("six-monomial reconstruction, row ",ii));
    if SHOW_ALL_SQUARING_ROWS then print([CR6[ii],collect(beta[ii],[a,b,c],factor)]); end if;
end do:
printf("PASS: all 71 polynomials are homogeneous quadratic (or zero).\n"):



