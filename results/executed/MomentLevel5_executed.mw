<Input><Text-field style="Maple Input" layout="Normal"># 5. Direct verify the discrete partition identity for N=4.
# For all 4^5 index-tuples, partition vector of the five singletons equals
# sum_{p != discrete} mu(p) xi_p, where mu(p)=(-1)^|p| prod (|B|-1)!.
# This is a finite exact check, not a check at a floating-point approximation.
Part5 := Words(5):
Discrete := [0,1,2,3,4]:
MobiusCoeff := proc(w::list)
    local count,uu,label,dd,blockCount;
    count := nops({op(w)});
    dd := (-1)^count;
    for label from 0 to count-1 do
        blockCount := nops(select(uu -&gt; uu=label,w));
        dd := dd*factorial(blockCount-1);
    end do;
    dd
end proc:
PartitionValue := proc(w::list,inds::list)
    local x,y;
    for x to 4 do for y from x+1 to 5 do
        if w[x]=w[y] and inds[x]&lt;&gt;inds[y] then return 0 end if;
    end do; end do;
    1
end proc:
for i1 to 4 do for i2 to 4 do for i3 to 4 do
for i4 to 4 do for i5 to 4 do
    inds := [i1,i2,i3,i4,i5]:
    total := 0:
    for pp in Part5 do
        if pp&lt;&gt;Discrete then
            total := total+MobiusCoeff(pp)*PartitionValue(pp,inds):
        end if:
    end do:
    if total&lt;&gt;1 then error &quot;Discrete identity fails for index tuple %1&quot;,inds end if:
end do; end do; end do; end do; end do:
