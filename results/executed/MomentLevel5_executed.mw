<Input><Text-field style="Maple Input" layout="Normal"># Moment level five, self-contained symbolic computation.
# The paper's five singleton deletions, four adjacent merges, and wrap merge.
# These reconstructed routines match the original 10 x 10 mathematical setup.
# This source has NOT been run in Maple in the present environment.
restart:
<Font encoding="UTF-8">printf(&quot;Moment five; Maple version: %a\134n&quot;,kernelopts(version)):
</Font>
</Text-field>
</Input>
<Output><Text-field style="Line Printed Output" layout="Line Printed Output">Moment five; Maple version: `Maple 2026.1, X86 64 WINDOWS, Jun 04 2026, Build ID 2018217`
</Text-field>
</Output>
</Group>
<Group view="presentation" hide-input="false" hide-output="false" inline-output="false" labelreference="L5" drawlabel="true">
<Input><Text-field style="Heading1" opaque="false" subscript="false" underline="false" superscript="false" bold="false" foreground="[0,0,0]" italic="false" executable="false" selection-placeholder="false" size="12" readonly="false" background="[255,255,255]" strikethrough="false" placeholder="false" family="Times New Roman" font_style_name="Heading1" layout="Normal">1. Partition utilities and exact checks.</Text-field>
</Input>
</Group>
<Group view="presentation" hide-input="false" hide-output="false" inline-output="false" labelreference="L6" drawlabel="true">
<Input><Text-field style="Maple Input" layout="Normal"># 1. Partition utilities and exact checks.
CheckZero := proc(expr, label::string)
    if normal(expand(expr)) &lt;&gt; 0 then error &quot;FAILED: %1&quot;, label end if;
    NULL
end proc:
CheckMatrix := proc(A, label::string)
    local ii,jj;
    for ii to LinearAlgebra:-RowDimension(A) do
        for jj to LinearAlgebra:-ColumnDimension(A) do
            CheckZero(A[ii,jj],cat(label,&quot; [&quot;,ii,&quot;,&quot;,jj,&quot;]&quot;));
        end do;
    end do;
<Font encoding="UTF-8">    printf(&quot;PASS: %s\134n&quot;,label);
</Font>    NULL
end proc:
Canon := proc(w::list)
    local seen,nextid,xx,out;
    seen := table(); nextid := 0; out := [];
    for xx in w do
        if not assigned(seen[xx]) then
            seen[xx] := nextid; nextid := nextid+1;
        end if;
        out := [op(out),seen[xx]];
    end do;
    out
end proc:
Words := proc(nn::nonnegint)
    local ws,newws,stage,w,mm,jj;
    ws := [[]];
    for stage to nn do
        newws := [];
        for w in ws do
            if nops(w)=0 then mm := -1 else mm := max(op(w)) end if;
            for jj from 0 to mm+1 do newws := [op(newws),[op(w),jj]] end do;
        end do;
        ws := newws;
    end do;
    ws
end proc:
Crossing := proc(w::list)
    local aa,bb,cc,dd,nn;
    nn := nops(w);
    for aa to nn-3 do for bb from aa+1 to nn-2 do
        for cc from bb+1 to nn-1 do for dd from cc+1 to nn do
            if w[aa]=w[cc] and w[bb]=w[dd] and w[aa]&lt;&gt;w[bb] then
                return true;
            end if;
        end do; end do;
    end do; end do;
    false
end proc:
Root := proc(parent,xx::posint)
    local rr; rr := xx;
    while parent[rr]&lt;&gt;rr do rr := parent[rr] end do;
    rr
end proc:
Join := proc(parent,xx::posint,yy::posint)
    parent[Root(parent,xx)] := Root(parent,yy);
    NULL
end proc:
Lower := proc(w::list,groups::list,caps::list)
    local parent,nn,g,jj,out,roots;
    nn := max(op(w))+1;
    parent := Array(1..nn,[seq(jj,jj=1..nn)]);
    for g in [op(groups),op(caps)] do
        for jj from 2 to nops(g) do
            Join(parent,w[g[1]]+1,w[g[jj]]+1);
        end do;
    end do;
    out := [seq(Root(parent,w[g[1]]+1),g in groups)];
    roots := {seq(Root(parent,jj),jj=1..nn)};
    [Canon(out),nops(roots minus {op(out)})]
end proc:


</Text-field>
</Input>
</Group>
<Group view="presentation" hide-input="false" hide-output="false" inline-output="false" labelreference="L7" drawlabel="true">
<Input><Text-field style="Heading1" opaque="false" subscript="false" underline="false" superscript="false" bold="false" foreground="[0,0,0]" italic="false" executable="false" selection-placeholder="false" size="12" readonly="false" background="[255,255,255]" strikethrough="false" placeholder="false" family="Times New Roman" font_style_name="Heading1" layout="Normal">2. Enumerate the ten crossing partitions and construct ten operations.</Text-field>
</Input>
</Group>
<Group view="presentation" hide-input="false" hide-output="false" inline-output="false" labelreference="L8" drawlabel="true">
<Input><Text-field style="Maple Input" layout="Normal"># 2. Enumerate the ten crossing partitions and construct ten operations.
CR5 := select(Crossing,Words(5)):
if nops(CR5)&lt;&gt;10 then error &quot;Expected ten crossing partitions&quot; end if:
F5 := []:
# Five singleton deletions: keep the other four, in their natural order.
for xx to 5 do
