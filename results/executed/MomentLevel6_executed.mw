<Input><Text-field style="Maple Input" layout="Normal"># 2. Partition composition for rotate-square-unrotate.
# Temporary labels are 1..9. Put the first partition at [1,2,3,6,5,4]
# and the second at [4,5,6,9,8,7]; read outputs [1,2,3,9,8,7].
# Internal connected components not meeting an output contribute N.
SquareGlue := proc(w::list,v::list)
    local parent,slots,words,which,aa,bb,jj,out,roots;
    parent := Array(1..9,[seq(jj,jj=1..9)]);
    slots := [[1,2,3,6,5,4],[4,5,6,9,8,7]];
    words := [w,v];
    for which to 2 do for aa to 6 do for bb to aa-1 do
        if words[which][aa]=words[which][bb] then
            Join(parent,slots[which][aa],slots[which][bb]);
        end if;
    end do; end do; end do;
    out := [seq(Root(parent,jj),jj in [1,2,3,9,8,7])];
    roots := {seq(Root(parent,jj),jj=1..9)};
    [Canon(out),nops(roots minus {op(out)})]
end proc:



</Text-field>
</Input>
